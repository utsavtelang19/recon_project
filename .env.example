# Reconnaissance Terminal Configuration
# Database Type: 'auto' (tries MySQL, falls back to SQLite), 'mysql', or 'sqlite'
DB_TYPE=auto

# MySQL Configuration (Default port 3306)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=recon_db

# SQLite Database File (Used when DB_TYPE=sqlite or MySQL fallback)
SQLITE_DB_PATH=recon.db

# Flask Secret Key for sessions
SECRET_KEY=recon-secret-key-change-in-production-2026-secure!

# Default Admin Seed Credentials (Created on first run if no admin exists)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@recon.local
ADMIN_PASSWORD=Admin@123
